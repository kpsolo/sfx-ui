# Production settings for the GitHub Pages build (`npm run build:pages`, mode "pages").
# Read by vite.config.ts. Values here are public: they end up in the built site.
# Environment variables (e.g. from the deploy workflow) override these.

# Repository name. The site is served from https://<owner>.github.io/<PAGES_REPO>/,
# so the build uses /<PAGES_REPO>/ as its base path. Set it empty for a user/org site
# (<owner>.github.io) or a custom domain served from the root.
PAGES_REPO=sfx-ui

# Chrome origin-trial token for HTML-in-Canvas (public by design; it ships in the HTML).
# Origin: https://kpsolo.github.io:443 · feature: HTMLInCanvas · expires 2026-10-20 00:00 UTC.
# Renew at https://developer.chrome.com/origintrials before it expires. A non-empty
# ORIGIN_TRIAL_TOKEN repository variable (Settings → Secrets and variables → Actions →
# Variables) overrides this value without a commit.
ORIGIN_TRIAL_TOKEN=AmMC6+tIr2VH0UptBRynmrSaIdvSY+RRo7c4LoI+zTiwod+hL1Dy6wKFwKspW4WDB8AnYCUEyfrakDSNiSUuMgQAAABWeyJvcmlnaW4iOiJodHRwczovL2twc29sby5naXRodWIuaW86NDQzIiwiZmVhdHVyZSI6IkhUTUxJbkNhbnZhcyIsImV4cGlyeSI6MTc5MjQ1NDQwMH0=
